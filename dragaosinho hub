		espCache[plr] = createEspElements()
	end
end

Players.PlayerAdded:Connect(function(plr)
	if plr ~= LocalPlayer then
		espCache[plr] = createEspElements()
	end
end)

Players.PlayerRemoving:Connect(function(plr)
	if espCache[plr] then
		for _, obj in pairs(espCache[plr]) do
			if typeof(obj) == "table" then
				for _, l in pairs(obj) do pcall(function() l:Remove() end) end
			else
				pcall(function() obj:Remove() end)
			end
		end
		espCache[plr] = nil
	end
end)

local function hideEsp(esp)
	esp.Box.Visible = false
	esp.Line.Visible = false
	esp.HealthBar.Visible = false
	esp.Name.Visible = false
	esp.Distance.Visible = false
	for _, l in pairs(esp.SkeletonLines) do l.Visible = false end
end

table.insert(connections, RunService.RenderStepped:Connect(function()
	for plr, esp in pairs(espCache) do
		local char = plr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")

		if char and hum and root and hum.Health > 0 then
			local vector, onScreen = Camera:WorldToViewportPoint(root.Position)
			
			if onScreen and vector.Z > 0 then
				local topPos = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 2.5, 0))
				local botPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
				local boxHeight = math.abs(topPos.Y - botPos.Y)
				local boxWidth = boxHeight / 2

				if state.EspBox then
					esp.Box.Size = Vector2.new(boxWidth, boxHeight)
					esp.Box.Position = Vector2.new(vector.X - boxWidth / 2, topPos.Y)
					esp.Box.Visible = true
				else
					esp.Box.Visible = false
				end

				if state.EspLine then
					esp.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
					esp.Line.To = Vector2.new(vector.X, botPos.Y)
					esp.Line.Visible = true
				else
					esp.Line.Visible = false
				end

				if state.EspHealth then
					local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
					esp.HealthBar.From = Vector2.new(vector.X - boxWidth / 2 - 6, botPos.Y)
					esp.HealthBar.To = Vector2.new(vector.X - boxWidth / 2 - 6, botPos.Y - (boxHeight * healthPercent))
					esp.HealthBar.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
					esp.HealthBar.Visible = true
				else
					esp.HealthBar.Visible = false
				end

				if state.EspName then
					esp.Name.Text = plr.Name
					esp.Name.Position = Vector2.new(vector.X, topPos.Y - 16)
					esp.Name.Visible = true
				else
					esp.Name.Visible = false
				end

				if state.EspDistance and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
					local dist = math.floor((root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude)
					esp.Distance.Text = dist .. "m"
					esp.Distance.Position = Vector2.new(vector.X, botPos.Y + 2)
					esp.Distance.Visible = true
				else
					esp.Distance.Visible = false
				end

				if state.EspSkeleton then
					local head = char:FindFirstChild("Head")
					local upperTorso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
					local leftArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
					local rightArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
					local leftLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
					local rightLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")

					if head and upperTorso then
						local hPos = Camera:WorldToViewportPoint(head.Position)
						local tPos = Camera:WorldToViewportPoint(upperTorso.Position)
						
						if hPos.Z > 0 and tPos.Z > 0 then
							esp.SkeletonLines.HeadToTorso.From = Vector2.new(hPos.X, hPos.Y)
							esp.SkeletonLines.HeadToTorso.To = Vector2.new(tPos.X, tPos.Y)
							esp.SkeletonLines.HeadToTorso.Visible = true
						else
							esp.SkeletonLines.HeadToTorso.Visible = false
						end

						if leftArm then
							local laPos = Camera:WorldToViewportPoint(leftArm.Position)
							if laPos.Z > 0 then
								esp.SkeletonLines.LeftArm.From = Vector2.new(tPos.X, tPos.Y)
								esp.SkeletonLines.LeftArm.To = Vector2.new(laPos.X, laPos.Y)
								esp.SkeletonLines.LeftArm.Visible = true
							else
								esp.SkeletonLines.LeftArm.Visible = false
							end
						end
						if rightArm then
							local raPos = Camera:WorldToViewportPoint(rightArm.Position)
							if raPos.Z > 0 then
								esp.SkeletonLines.RightArm.From = Vector2.new(tPos.X, tPos.Y)
								esp.SkeletonLines.RightArm.To = Vector2.new(raPos.X, raPos.Y)
								esp.SkeletonLines.RightArm.Visible = true
							else
								esp.SkeletonLines.RightArm.Visible = false
							end
						end
						if leftLeg then
							local llPos = Camera:WorldToViewportPoint(leftLeg.Position)
							if llPos.Z > 0 then
								esp.SkeletonLines.LeftLeg.From = Vector2.new(tPos.X, tPos.Y)
								esp.SkeletonLines.LeftLeg.To = Vector2.new(llPos.X, llPos.Y)
								esp.SkeletonLines.LeftLeg.Visible = true
							else
								esp.SkeletonLines.LeftLeg.Visible = false
							end
						end
						if rightLeg then
							local rlPos = Camera:WorldToViewportPoint(rightLeg.Position)
							if rlPos.Z > 0 then
								esp.SkeletonLines.RightLeg.From = Vector2.new(tPos.X, tPos.Y)
								esp.SkeletonLines.RightLeg.To = Vector2.new(rlPos.X, rlPos.Y)
								esp.SkeletonLines.RightLeg.Visible = true
							else
								esp.SkeletonLines.RightLeg.Visible = false
							end
						end
					else
						for _, l in pairs(esp.SkeletonLines) do l.Visible = false end
					end
				else
					for _, l in pairs(esp.SkeletonLines) do l.Visible = false end
				end
			else
				hideEsp(esp)
			end
		else
			hideEsp(esp)
		end
	end
end))

