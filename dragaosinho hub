local function createEspElements()
	local esp = {}
	esp.Box = Drawing.new("Square")
	esp.Box.Visible = false
	esp.Box.Thickness = 1
	esp.Box.Color = Color3.fromRGB(255, 100, 100)
	esp.Box.Filled = false

	esp.Line = Drawing.new("Line")
	esp.Line.Visible = false
	esp.Line.Thickness = 1
	esp.Line.Color = Color3.fromRGB(255, 100, 100)

	esp.HealthBar = Drawing.new("Line")
	esp.HealthBar.Visible = false
	esp.HealthBar.Thickness = 2
	esp.HealthBar.Color = Color3.fromRGB(0, 255, 0)

	esp.Name = Drawing.new("Text")
	esp.Name.Visible = false
	esp.Name.Size = 14
	esp.Name.Center = true
	esp.Name.Outline = true
	esp.Name.Color = Color3.fromRGB(255, 255, 255)

	esp.Distance = Drawing.new("Text")
	esp.Distance.Visible = false
	esp.Distance.Size = 12
	esp.Distance.Center = true
	esp.Distance.Outline = true
	esp.Distance.Color = Color3.fromRGB(200, 200, 200)

	esp.SkeletonLines = {
		HeadToTorso = Drawing.new("Line"),
		LeftArm = Drawing.new("Line"),
		RightArm = Drawing.new("Line"),
		LeftLeg = Drawing.new("Line"),
		RightLeg = Drawing.new("Line")
	}

	for _, line in pairs(esp.SkeletonLines) do
		line.Visible = false
		line.Thickness = 1
		line.Color = Color3.fromRGB(255, 255, 255)
		table.insert(activeDrawings, line)
	end

	table.insert(activeDrawings, esp.Box)
	table.insert(activeDrawings, esp.Line)
	table.insert(activeDrawings, esp.HealthBar)
	table.insert(activeDrawings, esp.Name)
	table.insert(activeDrawings, esp.Distance)

	return esp
end

for _, plr in ipairs(Players:GetPlayers()) do
