  pcall(function() ping=tostring(math.floor(LocalPlayer:GetNetworkPing()*1000)) end)
  statusInfo.Text=string.format('FPS: %d  |  Ping: %s ms  |  Jogadores: %d',math.floor(avgFps),ping,#Players:GetPlayers())
 end
